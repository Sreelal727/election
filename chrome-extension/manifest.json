{
  "manifest_version": 3,
  "name": "Election Pulse — Kerala 2026",
  "version": "1.0.0",
  "description": "Social media sentiment collector for Kerala 2026 Assembly Elections. Tracks LDF/UDF/NDA sentiment across Reddit, Facebook, Twitter/X, and Instagram.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "*://*.reddit.com/*",
    "*://*.facebook.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/reddit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/twitter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Election Pulse"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["keywords/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
